#pragma experiment("BRIDGE_CONNECT")

import ElectricPower
import Resistor
import Capacitor
import has_net_name

from "parts/ch32x035.ato" import CH32X035G8U6
from "parts/usb_type_c.ato" import UsbTypeC_16P
from "parts/mini_din7.ato" import MiniDin7Male
from "parts/buttons.ato" import TactSwitch_2P
from "parts/ldo_3v3.ato" import Ldo3V3
from "parts/level_shifter.ato" import LevelShifter8Bit


module X68000Keyboard:
    """
    Mimic X — X68000 キーボード / マウス アダプタ。

    USB Type-C (sink/UFP)  ──>  CH32X035G8U6 (MCU, USB FS, 3.3V)
                                       ↕  TC7MPB9307FT (5V↔3.3V level shifter)
                              ──>  Mini DIN 7pin オス (X68000 キーボード端子, 5V TTL)

    キーボード本体とマウス端子を兼ねた 1 コネクタ構成。ファーム側は
    `BOARD_X68K_FULL` ビルドで両方をエミュレートする。

    ピン割当・設計理由は README.md と ../docs/CH32X035.md を参照。
    """

    # ===== トップレベル電源レール =====
    vbus = new ElectricPower    # USB バスパワー (5V)
    trait vbus.hv has_net_name<name="VBUS">
    trait vbus.lv has_net_name<name="GND">

    # MCU 用 3.3V レール。CH32X035 の USB トランシーバ出力は VDD 直結のため、
    # USB ホスト互換性 (特に Pixel 等の規格準拠ホスト) の観点から VDD は必ず
    # 3.3V に降圧する。詳細は ../docs/CH32X035.md と parts/ldo_3v3.ato を参照。
    vdd33 = new ElectricPower
    trait vdd33.hv has_net_name<name="VDD33">
    trait vdd33.lv has_net_name<name="GND">

    # ===== サブブロック =====
    mcu  = new CH32X035G8U6
    usbc = new UsbTypeC_16P
    kbd  = new MiniDin7Male
    ldo  = new Ldo3V3
    lvls = new LevelShifter8Bit    # 5V <-> 3.3V レベルシフタ (TC7MPB9307FT)

    # ===== USB Type-C: 5.1kΩ CC プルダウン (UFP / sink) + MCU PD 検出 =====
    # 5.1kΩ プルダウンは UFP/sink 識別用 (USB Type-C 仕様の Rd)。加えて
    # CH32X035 の内蔵 USB-PD コントローラが CC ラインを直接サンプリングできる
    # よう、PC14 (CC1) / PC15 (CC2) を CC ネットに直接接続する。プルダウン経由で
    # 5V 系の Rp 分圧 (max ~1.7V @ 3A 広告) しか印加されないため、MCU の絶対
    # 最大定格 (VDD+0.3V = 3.6V) は満たされる。
    rcc1 = new Resistor
    rcc1.resistance = 5.1kohm +/- 5%
    rcc1.package = "I0402"
    usbc.cc1 ~> rcc1 ~> vbus.lv
    mcu.PC14 ~ usbc.cc1

    rcc2 = new Resistor
    rcc2.resistance = 5.1kohm +/- 5%
    rcc2.package = "I0402"
    usbc.cc2 ~> rcc2 ~> vbus.lv
    mcu.PC15 ~ usbc.cc2

    # ===== USB 電源とデータ =====
    usbc.vbus ~ vbus.hv
    usbc.gnd  ~ vbus.lv

    # ===== 5V (VBUS) -> 3.3V (VDD33) LDO =====
    ldo.power_in  ~ vbus
    ldo.power_out ~ vdd33

    # MCU は 3.3V で駆動 (USB トランシーバの D+/D- 出力レベルを 3.3V に揃える)
    mcu.vdd ~ vdd33.hv
    mcu.vss ~ vdd33.lv

    # USB D+/D- — できるだけ短く、90Ω 差動配線が望ましい。
    # TODO: コモンモードチョーク + ESD TVS アレイ (USBLC6-2SC6 等) を追加する。
    usbc.dp ~ mcu.usb_dp
    usbc.dn ~ mcu.usb_dm

    # ===== VDD33 デカップリング (MCU の VDD ピン直近に配置) =====
    cbulk = new Capacitor
    cbulk.capacitance = 4.7uF +/- 20%
    cbulk.package = "I0603"
    cbulk.power ~ vdd33

    cdec = new Capacitor
    cdec.capacitance = 100nF +/- 10%
    cdec.package = "I0402"
    cdec.power ~ vdd33

    # ===== デバッグ LED は実装しない (基板小型化のため省略) =====
    # PB3 / PB4 は未使用ピンとして残しておく。将来的な拡張で必要なら
    # この位置に LedGreen0603 / LedRed0603 + 470Ω 直列抵抗を再挿入する。

    # ===== BOOT ボタン — リセット時に PC17 (USB D+) を HIGH に引き上げる =====
    # WCH ISP ブートローダ仕様: リセット時 UDP (PC17) が HIGH なら MCU は
    # USB DFU ブートローダに入る。4.7kΩ 直列抵抗で USB データラインと電源を
    # 分離し、通常の USB enumeration ではホスト側が D+ を駆動できるようにする。
    #
    # 重要: ここは VBUS (5V) ではなく VDD33 (3.3V) を使う。USB D+ アイドル電圧は
    # VDD レベル (= 3.3V) であるため、5V を印加すると規格違反となり、Pixel 等の
    # 規格準拠ホストで attach できなくなる。
    #
    # VDD33 ── btn ── 4.7kΩ ── PC17 (mcu.usb_dp)
    boot_btn = new TactSwitch_2P
    rboot = new Resistor
    rboot.resistance = 4.7kohm +/- 5%
    rboot.package = "I0402"
    vdd33.hv ~ boot_btn.terminal_a
    boot_btn.terminal_b ~> rboot ~> mcu.usb_dp

    # ===== レベルシフタ (TC7MPB9307FT) — MCU 3.3V 側 と DIN 5V 側を分離 =====
    # 重要: CH32X035 は 5V トレラントでない (絶対最大定格 VIN ≤ VDD+0.3V =
    # 3.6V at VDD=3.3V)。X68000 キーボード端子は全信号 5V TTL (本体側 8255 /
    # SN74LSxx 系の駆動とプルアップ 5V) であり、直結すると MCU ピンが定格を
    # 超え破損する。TC7MPB9307FT (パッシブ FET バススイッチ) で A=VDD33 /
    # B=VBUS に分離し、MCU には常に 3.3V クランプされた信号のみ届くようにする。
    # 8 チャネル中 5 ch を使用、残り 3 ch (a6/a7/a8) は A 側を GND に固定。
    lvls.power_a ~ vdd33    # A 側 = MCU の 3.3V
    lvls.power_b ~ vbus     # B 側 = X68000 の 5V

    # ===== Mini DIN 7pin (X68000 キーボード / マウス端子) =====
    # ピンラベルは X68000 サービスマニュアル準拠 (ホスト視点の Tx/Rx)。
    # MCU は本体 (X68000) からの送信線 (KEY TxD / Pin 4) を受信し、本体への
    # 応答 (KEY RxD / Pin 3) を送信する。
    #
    # 接続マップ (MCU ピン ↔ レベルシフタ ↔ DIN ピン):
    #   PB11 (USART1_RX, RX1_2 リマップ)    ↔ a1/b1 ↔ Pin 4 KEY TxD (host→kbd)
    #   PB10 (USART1_TX, default)           ↔ a2/b2 ↔ Pin 3 KEY RxD (kbd→host)
    #   PB12 (GPIO 入力)                    ↔ a3/b3 ↔ Pin 5 READY (host→kbd)
    #   PB9  (USART4_TX, TX4_3 リマップ)    ↔ a4/b4 ↔ Pin 2 MSDATA (kbd→host)
    #   PB8  (GPIO)                         ↔ a5/b5 ↔ Pin 6 REMOTE (TV リモコン)
    mcu.PB11 ~ lvls.a1;  lvls.b1 ~ kbd.key_txd    # MCU が受信
    mcu.PB10 ~ lvls.a2;  lvls.b2 ~ kbd.key_rxd    # MCU が送信
    mcu.PB12 ~ lvls.a3;  lvls.b3 ~ kbd.ready      # MCU が受信
    mcu.PB9  ~ lvls.a4;  lvls.b4 ~ kbd.msdata     # MCU が送信 (マウスデータ)
    mcu.PB8  ~ lvls.a5;  lvls.b5 ~ kbd.remote     # MCU GPIO (用途は将来検討)

    # 未使用 3 チャネル — A 側を GND に落としてフロート回避
    lvls.a6 ~ vdd33.lv
    lvls.a7 ~ vdd33.lv
    lvls.a8 ~ vdd33.lv

    # TODO: DIN 各信号ライン (lvls.b1〜b5 と kbd の間) に TVS ダイオードアレイ
    # (例: SP3012-04UTG, PESD5V0S4UD など) を追加して ESD 保護を強化する。
    # キーボードケーブルは外部に長く伸びるため特に重要。

    # ホストと共通 GND
    kbd.gnd ~ vbus.lv

    # Pin 1 (Vcc2 = ホスト +5V): 既定では NC。基板上の電源は USB バスパワー
    # から取得する (案 A)。VBUS と Vcc2 を同時通電させると逆流リスクがある
    # ため、後付けで 0Ω ジャンパや Schottky ダイオードを VBUS に向けて
    # 追加する場合のみ Pin 1 を接続する想定。
