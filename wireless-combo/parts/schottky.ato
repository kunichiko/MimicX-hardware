# ショットキーバリアダイオード — ラッパーモジュール
#
# アトミック部品は `parts/B5819W_SOD123/B5819W_SOD123.ato`。電源 OR-ing
# (VCC_JOY / VCC_KBD → VCC_ESP) に使う。

from "B5819W_SOD123/B5819W_SOD123.ato" import B5819W_SOD123_package


module SchottkyDiode:
    """ショットキーバリアダイオード B5819W (SOD-123) の MimicX 用ラッパー。

    使用例 (電源 OR-ing):
        d = new SchottkyDiode
        vcc_joy.hv ~ d.anode
        d.cathode ~ vcc_esp.hv
    """

    chip = new B5819W_SOD123_package

    signal anode;   anode   ~ chip.A
    signal cathode; cathode ~ chip.K
