# SS14 — ショットキーバリアダイオード (SMA/DO-214AC) アトミック部品定義
#
# 電源 OR-ing 用 (VCC_JOY / VCC_KBD → VCC_ESP)。
#   Vrrm=40V, If=1A, Vf≈0.35V @0.3A / 0.5V @1A
#   LCSC C2480 (MDD Microdiode Electronics)、JLCPCB Basic Part
#
# ⚠ フットプリントは標準 SMA の仮置き。発注前に KiCad 側で
#   データシート推奨ランドと照合すること。
#
# ピン配置 (SMA, カソードマーク側 = pin 1):
#   1: K (Cathode)   2: A (Anode)

import has_designator_prefix
import has_part_picked
import is_atomic_part


component SS14_SMA_package:
    """ショットキーバリアダイオード SS14 (SMA/DO-214AC)。"""

    trait is_atomic_part<manufacturer="MDD", partnumber="SS14", footprint="SS14_SMA.kicad_mod", symbol="SS14_SMA.kicad_sym", model="SS14_SMA.step">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C2480", manufacturer="MDD(Microdiode Electronics)", partno="SS14">
    trait has_designator_prefix<prefix="D">

    signal K ~ pin 1    # Cathode (マーク側)
    signal A ~ pin 2    # Anode
